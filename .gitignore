# 只收代码、配置和文档。游戏原文件、提取出来的音频/文本、生成的配音和发布包都不进仓库。
/*
!/.gitignore
!/README.md
!/LICENSE
!/HANDOFF.md
!/ra3cv.py
!/units.json
!/fx_presets.json
!/ra3voice/
!/tools/
!/tests/
!/installer/
!/docs/
!/lines/
!/work/
!/experimental/

/lines/*
!/lines/GLOSSARY.md
/work/*
!/work/terms/
/work/terms/*
!/work/terms/term_map.json
!/work/terms/term_map_add.json
!/work/terms/untranslated_zh.json
!/work/speakers/
/work/speakers/*
!/work/speakers/ref_override.json
!/work/speakers/fallback.json
# game footage stays out of the repo
/docs/article/img/fig1_cover.png

/installer/gui/out/
__pycache__/
*.pyc
.mineru/
