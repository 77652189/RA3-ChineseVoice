# 只收代码、配置和文档。游戏原文件、提取出来的音频/文本、生成的配音和发布包都不进仓库。
/*
!/.gitignore
!/README.md
!/HANDOFF.md
!/ra3cv.py
!/units.json
!/fx_presets.json
!/ra3voice/
!/tools/
!/tests/
!/installer/
!/docs/
!/lines/
!/work/

/lines/*
!/lines/GLOSSARY.md
/work/*
!/work/terms/
/work/terms/*
!/work/terms/term_map.json
!/work/terms/term_map_add.json
!/work/terms/untranslated_zh.json

/installer/gui/out/
__pycache__/
*.pyc
.mineru/
