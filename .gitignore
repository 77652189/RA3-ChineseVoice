# 只收代码、配置和文档。游戏原文件、提取出来的音频/文本、生成的配音和发布包都不进仓库。
/*
!/.gitignore
!/README.md
!/LICENSE
!/HANDOFF.md
!/ra3cv.py
!/units.json
!/fx_presets.json
!/ra3voice/
!/tools/
!/tests/
!/installer/
!/docs/
!/lines/
!/work/

/lines/*
!/lines/GLOSSARY.md
/work/*
!/work/movie_offsets.json
!/work/terms/
/work/terms/*
!/work/terms/term_map.json
!/work/terms/term_map_add.json
!/work/terms/untranslated_zh.json
!/work/terms/pronounce.json
!/work/speakers/
/work/speakers/*
!/work/speakers/ref_override.json
!/work/speakers/fallback.json
!/work/speakers/bad_onset_refs.json
!/work/speakers/ref_override_mission.json
# game footage stays out of the repo
/docs/article/img/fig1_cover.png

/installer/gui/out/
__pycache__/
*.pyc
.mineru/


# release indexes: per-file hashes of each published base (future patches diff against them); test builds stay out
!/releases/
/releases/*
!/releases/20261013-1101.json
!/releases/20261017-0012.json
